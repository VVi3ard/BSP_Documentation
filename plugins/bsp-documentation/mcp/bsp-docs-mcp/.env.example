# Set this in the process environment; do not commit a real key.
OPENROUTER_API_KEY=

# Build/manual-run overrides. Do not change the model for a prebuilt index:
# query-time and index-time embedding models must match exactly.
# BSP_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# BSP_DOCS_DATA_DIR=D:\path\to\bsp-docs-data
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
